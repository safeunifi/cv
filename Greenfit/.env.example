# Copy this file to .env and fill in your real keys
# NEVER commit .env to GitHub — it is blocked by .gitignore

# ── Supabase (your database) ──────────────────────────────────────────────────
# Get these from: https://supabase.com → your project → Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ── Anthropic / NemoClaw AI Coach ─────────────────────────────────────────────
# Get this from: https://console.anthropic.com → API Keys
# NOTE: For production, move this to a backend server — don't ship keys in the app bundle
EXPO_PUBLIC_ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── USDA Food Database (nutrition search) ─────────────────────────────────────
# Get a free key from: https://fdc.nal.usda.gov/api-guide.html
# The app works without this but food search won't return results
EXPO_PUBLIC_USDA_API_KEY=your-usda-key-here
